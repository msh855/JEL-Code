. 
. * prep for equations
. 
. local eqsiv1 ""

. local h1 = `horizon'+1

. forv h=1/`h1' {
  2.         local j=`h'-1
  3.         local eqsiv1 "`eqsiv1' (eq`h': rinfla_f`j' - {binfla`j'}*rpolicyrate -{cinfla`j'}) "
  4. }

. 
. local eqsiv2 ""

. local h11 = `h1'+1

. local h2  = 2*`horizon' + 2

. forv h=`h11'/`h2' {
  2.         local j=`h'-`h11'
  3.         local eqsiv2 "`eqsiv2' (eq`h': rinfle_f`j' - {binfle`j'}*rpolicyrate -{cinfle`j'}) "
  4. }

. 
. local eqsiv3 ""

. local h21 = `h2'+1

. local h3  = 3*`horizon' + 3

. forv h=`h21'/`h3' {
  2.         local j=`h'-`h21'
  3.         local eqsiv3 "`eqsiv3' (eq`h': rugap_f`j' - {bugap`j'}*rpolicyrate -{cugap`j'}) "
  4. }

. 
. * Use to verify equations correctly specified
. *disp "`eqsiv1'"
. *disp "`eqsiv2'"
. *disp "`eqsiv3'"
. 
. * prep for row and column drops
. local rcdrop ""

. local first = 1

. local last  = 2*`horizon'+1

. forv h=`first'(2)`last' {
  2.         if `h'>`first'  local rcdrop "`rcdrop',"
  3.         local rcdrop "`rcdrop'`h'"
  4. }

. disp "`rcdrop'"
