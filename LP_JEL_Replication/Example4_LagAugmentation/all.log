.  
. gr drop _all

. 
. clear

. set more off 

. set trace off

. 
. *** Choose the features of your model
. 
. global nobs 300

. global burn     1000

. global tobs = $nobs + $burn

. 
. global ayy      0.85

. global ayx      0.2

. global axy      0.2

. global axx      0.85

. 
. global byx      1

. 
. global p        0.05

. 
. *** Choose the horizon for your LP
. local h         13

. 
. set obs  $tobs
Number of observations (_N) was 0, now 1,300.

. gen t = _n

. 
. tsset t

Time variable: t, 1 to 1300
        Delta: 1 unit

. *** Generate data from the model
. set seed 12345

. gen uy  = rnormal()

. gen ux  = rnormal()

. 
. gen y   = 0

. gen x   = 0

. 
. replace y = $ayy*l.y + $ayx*l.x + $byx*ux + uy  if _n > 1
(1,299 real changes made)

. replace x = $axy*l.y + $axx*l.x + ux                    if _n > 1
(1,299 real changes made)

. 
. drop if _n <= $burn
(1,000 observations deleted)

. replace t = _n 
(300 real changes made)

. 
. *** Estimate the response of x to a shock in y with LP
. *** Generate empty vector to fill with estimates
. gen b   = .
(300 missing values generated)

. gen snw = .
(300 missing values generated)

. gen sla = .
(300 missing values generated)

. 
. sort t, stable

. tsset t

Time variable: t, 1 to 300
        Delta: 1 unit

. 
. 
. *** Generate the forward variables and reg
. gen h=_n-1

. 
. forvalues i = 0/`h'{
  2.         newey f`i'.x y l.y l.x, lag(6)
  3.         replace b       = _b[y]         if h == `i'
  4.         replace snw     = _se[y]        if h == `i'
  5.         
.         reg f`i'.x y l(1/2).y l(1/2).x, vce(hc3)
  6.         replace sla     = _se[y]        if h == `i'
  7.         
. }

