. levelsof iso , local(ctys)
`"AUS"' `"BEL"' `"CAN"' `"DEU"' `"DNK"' `"ESP"' `"FIN"' `"FRA"' `"GBR"' `"I
> RL"' `"ITA"' `"JPN"' `"NLD"' `"PRT"' `"SWE"' `"USA"'

. foreach c in `ctys' {
  2.         disp "`c'"
  3.         gen temp0 = y if iso=="`c'"
  4.         gen ifsyear = ifs*10000+year
  5.         tsset ifsyear // temporary
  6.         tsfilter hp temp1 = temp0  , smooth(400) trend(temp2)
  7.         replace y_hpcyc = temp1 if iso=="`c'"
  8.         replace y_hptrend = temp2 if iso=="`c'"
  9.         list iso year y y_hpcyc if temp0~=.
 10.         cap drop temp* ifsyear
 11. }
